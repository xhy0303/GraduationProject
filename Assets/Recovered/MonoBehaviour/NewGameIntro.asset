%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2eee263bef41c494e8748f9bb06b5c33, type: 3}
  m_Name: NewGameIntro
  m_EditorClassIdentifier:
  dialoguePieces:
  - ID: 01
    image: {fileID: 21300000, guid: 564936c4c9d13a74e8f9862336de573c, type: 2}
    text: 你好啊！勇敢的小骑士！
    playTineLine: 0
    options: []
  - ID: 02
    image: {fileID: 21300000, guid: 564936c4c9d13a74e8f9862336de573c, type: 2}
    text: 今天的天气真不错啊~
    playTineLine: 0
    options:
    - text: 的确很不错呢~
      targetID: 03
  - ID: 03
    image: {fileID: 21300000, guid: 564936c4c9d13a74e8f9862336de573c, type: 2}
    text: 你看到远处的堡垒了吗？
    playTineLine: 1
    options: []
  - ID: 04
    image: {fileID: 21300000, guid: 564936c4c9d13a74e8f9862336de573c, type: 2}
    text: "堡垒的第三层中有蕴含着强大力量的水晶，你有能力帮我拿回来吗？\n我会用我的魔法装备和你交换的~"
    playTineLine: 0
    options:
    - text: 那当然！
      targetID: 05
    - text: 我试试吧
      targetID: 06
  - ID: 05
    image: {fileID: 21300000, guid: 564936c4c9d13a74e8f9862336de573c, type: 2}
    text: 不愧是骑士！
    playTineLine: 0
    options: []
  - ID: 06
    image: {fileID: 21300000, guid: 564936c4c9d13a74e8f9862336de573c, type: 2}
    text: 在旁边的桌子上我为你准备了一套装备
    playTineLine: 0
    options: []
  - ID: 07
    image: {fileID: 21300000, guid: 564936c4c9d13a74e8f9862336de573c, type: 2}
    text: 去吧，勇敢的小骑士！
    playTineLine: 0
    options: []
